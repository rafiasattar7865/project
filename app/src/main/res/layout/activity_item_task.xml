<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_form_card"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Design"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/txtPriorityStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="⭐"
                android:textSize="18sp"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/txtTaskDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="task description"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:textColor="#555555"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#AACB73"
            android:alpha="0.3"
            android:layout_marginVertical="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Design"
                android:background="@drawable/tab_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:backgroundTint="#FFD4D4"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/txtDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Today | 10:30 PM"
                android:textColor="#888888"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>