<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noteFormRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_form_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Note"
                android:textColor="#AACB73"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/edtNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Title"
                android:background="@drawable/tab_pill"
                android:paddingStart="16dp"
                android:layout_marginBottom="12dp"
                android:inputType="textCapSentences"/>

            <EditText
                android:id="@+id/edtNoteContent"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Write something..."
                android:gravity="top"
                android:padding="12dp"
                android:background="@drawable/bg_form_card"
                android:layout_marginBottom="16dp"
                android:textSize="14sp"
                android:inputType="textMultiLine"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/btnAttachFile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_attachment"
                    android:background="@drawable/tab_pill"
                    android:layout_marginEnd="8dp"
                    app:tint="#333333"/>

                <ImageView
                    android:id="@+id/btnAddLink"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_link"
                    android:background="@drawable/tab_pill"
                    app:tint="#333333"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerFilePreviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/containerLinkPreviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSaveNote"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:text="Save Note"
                android:textAllCaps="false"
                android:background="@drawable/btn_save_style"
                android:textColor="#000000"
                android:textSize="18sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>