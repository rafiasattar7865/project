<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eventFormRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardEventMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_form_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Event"
                android:textColor="#AACB73"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/edtEventTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="What's the plan?"
                android:background="@drawable/tab_pill"
                android:paddingStart="16dp"
                android:layout_marginBottom="12dp"
                android:inputType="textCapSentences"/>

            <EditText
                android:id="@+id/edtEventLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Where at?"
                android:background="@drawable/tab_pill"
                android:paddingStart="16dp"
                android:layout_marginBottom="12dp"
                android:inputType="textCapSentences"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="When is it happening?"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"
                android:textColor="#AACB73"
                android:layout_marginStart="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/btnPickDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:hint="Date"
                    android:background="@drawable/tab_pill"
                    android:paddingStart="16dp"
                    android:layout_marginEnd="6dp"
                    android:focusable="false"
                    android:clickable="true"/>

                <EditText
                    android:id="@+id/btnPickTime"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:hint="Time"
                    android:background="@drawable/tab_pill"
                    android:paddingStart="16dp"
                    android:layout_marginStart="6dp"
                    android:focusable="false"
                    android:clickable="true"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveEvent"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="Save Event"
                android:textAllCaps="false"
                android:background="@drawable/btn_save_style"
                android:textColor="#000000"
                android:textSize="18sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>